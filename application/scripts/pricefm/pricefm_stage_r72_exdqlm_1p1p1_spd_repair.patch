new file mode 100644
index 0000000..12f9c66
--- /dev/null
+++ b/R/pricefm_spd_repair.R
@@ -0,0 +1,75 @@
+.pricefm_safe_spd_chol <- function(A, context = "qbeta", iter = NA_integer_) {
+  A <- as.matrix(A)
+  if (length(dim(A)) != 2L || nrow(A) != ncol(A) || !nrow(A)) {
+    stop("PriceFM SPD repair requires a nonempty square matrix.", call. = FALSE)
+  }
+  if (any(!is.finite(A))) {
+    stop("PriceFM SPD repair rejected non-finite precision matrix entries.", call. = FALSE)
+  }
+  p <- nrow(A)
+  make_result <- function(chol, path, jitter, scale, attempts) {
+    list(
+      chol = chol,
+      diagnostics = data.frame(
+        context = as.character(context),
+        iter = as.integer(iter),
+        factorization_path = as.character(path),
+        absolute_jitter = as.numeric(jitter),
+        matrix_scale = as.numeric(scale),
+        relative_jitter = as.numeric(jitter / scale),
+        attempts = as.integer(attempts),
+        stringsAsFactors = FALSE
+      )
+    )
+  }
+
+  scale0 <- max(1, max(abs(diag(A))))
+  direct <- tryCatch(chol(A), error = function(e) NULL)
+  if (!is.null(direct)) {
+    return(make_result(direct, "direct", 0, scale0, 1L))
+  }
+
+  legacy <- tryCatch(chol(A + 1e-10 * diag(p)), error = function(e) NULL)
+  if (!is.null(legacy)) {
+    return(make_result(legacy, "legacy_absolute_1e-10", 1e-10, scale0, 2L))
+  }
+
+  A_sym <- (A + t(A)) / 2
+  scale <- max(1, max(abs(diag(A_sym))), max(abs(A_sym)))
+  relative_ladder <- c(
+    .Machine$double.eps, 1e-15, 1e-14, 1e-13, 1e-12,
+    1e-11, 1e-10, 1e-9, 1e-8
+  )
+  attempts <- 2L
+  original_diag <- diag(A_sym)
+  for (relative in relative_ladder) {
+    jitter <- scale * relative
+    candidate <- A_sym
+    diag(candidate) <- original_diag + jitter
+    if (identical(diag(candidate), original_diag)) next
+    attempts <- attempts + 1L
+    factor <- tryCatch(chol(candidate), error = function(e) NULL)
+    if (!is.null(factor)) {
+      return(make_result(
+        factor,
+        "scale_aware_symmetric_relative",
+        jitter,
+        scale,
+        attempts
+      ))
+    }
+  }
+  stop(
+    sprintf(
+      paste0(
+        "PriceFM SPD repair exhausted bounded jitter ladder ",
+        "(context=%s, iter=%s, p=%d, scale=%.17g, max_relative_jitter=1e-8)."
+      ),
+      context,
+      as.character(iter),
+      p,
+      scale
+    ),
+    call. = FALSE
+  )
+}
