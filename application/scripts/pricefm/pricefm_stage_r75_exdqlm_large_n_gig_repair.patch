+.pricefm_log_bessel_k_uniform <- function(x, nu) {
+  x <- as.numeric(x)[1L]
+  order <- abs(as.numeric(nu)[1L])
+  if (!is.finite(x) || x <= 0 || !is.finite(order) || order <= 0) {
+    return(NA_real_)
+  }
+  z <- x / order
+  root <- sqrt(1 + z * z)
+  eta <- root + log(z) - log1p(root)
+  t <- 1 / root
+  u1 <- (3 * t - 5 * t^3) / 24
+  u2 <- (81 * t^2 - 462 * t^4 + 385 * t^6) / 1152
+  series <- 1 - u1 / order + u2 / (order * order)
+  if (!all(is.finite(c(z, root, eta, series))) || series <= 0) {
+    return(NA_real_)
+  }
+  0.5 * (log(pi) - log(2 * order)) - 0.25 * log1p(z * z) -
+    order * eta + log(series)
+}
+
+.pricefm_log_bessel_k <- function(x, nu) {
+  x <- as.numeric(x)[1L]
+  nu <- as.numeric(nu)[1L]
+  if (!is.finite(x) || x <= 0 || !is.finite(nu)) return(NA_real_)
+  direct <- suppressWarnings(besselK(x, nu = abs(nu), expon.scaled = TRUE))
+  if (abs(nu) <= 500 && length(direct) == 1L && is.finite(direct) && direct > 0) {
+    return(structure(log(direct) - x, backend = "base_R_scaled"))
+  }
+  value <- .pricefm_log_bessel_k_uniform(x, nu)
+  if (!is.finite(value)) return(NA_real_)
+  structure(value, backend = "uniform_large_order")
+}
+
+.pricefm_bessel_order_derivative <- function(x, nu, order = 1L) {
+  order <- as.integer(order)[1L]
+  scale <- max(1, abs(as.numeric(nu)[1L]))
+  h <- if (order == 1L) max(1e-5, 1e-5 * scale) else max(1e-4, 1e-4 * scale)
+  values <- vapply(
+    c(-2, -1, 0, 1, 2),
+    function(step) as.numeric(.pricefm_log_bessel_k(x, nu + step * h)),
+    numeric(1L)
+  )
+  if (any(!is.finite(values))) return(NA_real_)
+  if (order == 1L) {
+    return((values[1L] - 8 * values[2L] + 8 * values[4L] - values[5L]) / (12 * h))
+  }
+  if (order == 2L) {
+    return((-values[5L] + 16 * values[4L] - 30 * values[3L] +
+      16 * values[2L] - values[1L]) / (12 * h^2))
+  }
+  stop("Unsupported Bessel order derivative.", call. = FALSE)
+}
